  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "guess the 4-digit number:\r\neach digit is unique\r\nyou have 10 attempts\r\n\r\nafter
    each guess, you get feedback:\r\n- the first shows how many digits are in the
    number but in the wrong spot\r\n- the second shows how many digits are in the
    right spot\r\n\r\nexample: if the number is 3981 and you guess 2931\r\nyou'd
    see: 3 and 2\r\n3 \u2014 three digits (9, 3, 1) are in the number but misplaced\r\n2
    \u2014 two digits (9, 1) are in the correct positionr"
  m_isRightToLeft: 0
