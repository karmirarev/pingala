      m_Calls: []
  m_text: 'guess the 4-digit number.

    every digit is different. you have 10 tries.


    after each guess you get two numbers:

    left: how many of your digits are in the number

    right: how many are in the right spot


    example: the number is 3981, you guess 2931. you see 3 and 2.


    hold a key to mark it with a dot when you are sure it is not in the number. hold it again to clear the dot.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: ac3c71b2f124a4866acc258b52da1411, type: 2}
